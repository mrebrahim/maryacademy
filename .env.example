# =====================================================================
# Marie Ragaie Beauty Academy — environment (PRD §11)
#
# Only NEXT_PUBLIC_* values ever reach the browser bundle. Everything
# else is server-only and must never be referenced from a client component.
# =====================================================================

# --- Supabase --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Bunny Stream (video) — PRD §6.2 ---------------------------------
# Library ID is the numeric id shown in the Bunny dashboard URL.
# API key: Stream → Library → API. Used server-side only, to read video
#   metadata and to sign playback tokens.
# Token auth key: Library → Security → Token Authentication Key. Different
#   value from the API key — signing with the wrong one yields 403s that
#   look like expiry.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Used by scripts/sync-bunny-lessons.ts. A read-only key is enough there,
# and a leaked one cannot delete a video.
BUNNY_STREAM_READONLY_API_KEY=
BUNNY_TOKEN_AUTH_KEY=
# The library's CDN host, e.g. vz-xxxxxxxx-xxx.b-cdn.net. Only needed for
# direct file URLs; the embed player does not use it.
BUNNY_CDN_HOSTNAME=
# Only the library id is safe in the browser: it appears in embed URLs.
# This one MUST also be set in Vercel, or no video plays in production.
NEXT_PUBLIC_BUNNY_LIBRARY_ID=

# --- InstaPay (manual settlement) ------------------------------------
# InstaPay has no merchant checkout API: the student transfers, submits a
# reference, and an admin confirms. This is the handle they transfer to.
NEXT_PUBLIC_INSTAPAY_HANDLE=
NEXT_PUBLIC_INSTAPAY_NAME=
# Deep link from the InstaPay app: Share → Copy link
NEXT_PUBLIC_INSTAPAY_LINK=

# --- Stripe (USD, secondary) -----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email -----------------------------------------------------------
RESEND_API_KEY=

# --- Site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tracking. Each id is opt-in: one that is not set injects no script at
# all, which is what keeps local and preview traffic out of the numbers.
# The funnel events are already written; these ids are the only thing
# that makes anything record them. GTM is optional — GA4 runs on its own.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Server-side purchase reporting. These are SECRETS — no NEXT_PUBLIC_
# prefix, so they never reach the browser. A Conversions API token in a
# page bundle lets a stranger write events into the ad account.
#
# The purchase is reported when an admin confirms a transfer, because
# that is the only moment the money is known to have arrived. Without
# these, everything up to checkout is still tracked; only the sale is
# missing.
FB_CONVERSIONS_API_TOKEN=
GA4_API_SECRET=
TIKTOK_ACCESS_TOKEN=

# TEMPORARY. Set it only while the Test Events tab is open, then REMOVE it.
# Meta excludes any event carrying a test code from reporting, optimisation
# and attribution — so if this is left set, every real sale disappears from
# the ad account while the integration still looks like it is working.
FB_TEST_EVENT_CODE=

# One number for enquiries and for transfer screenshots alike.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# InstaPay and Vodafone Cash — both manual, both confirmed by a human.
NEXT_PUBLIC_VODAFONE_CASH_NUMBER=
NEXT_PUBLIC_VODAFONE_CASH_NAME=

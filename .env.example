# =====================================================================
# Marie Ragaie Beauty Academy — environment (PRD §11)
#
# Only NEXT_PUBLIC_* values ever reach the browser bundle. Everything
# else is server-only and must never be referenced from a client component.
# =====================================================================

# --- Supabase --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Bunny Stream (video) — PRD §6.2 ---------------------------------
# Library ID is the numeric id shown in the Bunny dashboard URL.
# API key: Stream → Library → API. Used server-side only, to read video
#   metadata and to sign playback tokens.
# Token auth key: Library → Security → Token Authentication Key. Different
#   value from the API key — signing with the wrong one yields 403s that
#   look like expiry.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_TOKEN_AUTH_KEY=
# Only the library id is safe in the browser: it appears in embed URLs.
NEXT_PUBLIC_BUNNY_LIBRARY_ID=

# --- InstaPay (manual settlement) ------------------------------------
# InstaPay has no merchant checkout API: the student transfers, submits a
# reference, and an admin confirms. This is the handle they transfer to.
NEXT_PUBLIC_INSTAPAY_HANDLE=
NEXT_PUBLIC_INSTAPAY_NAME=

# --- Stripe (USD, secondary) -----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email -----------------------------------------------------------
RESEND_API_KEY=

# --- Site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
